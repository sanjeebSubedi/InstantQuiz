EMAIL=QuizApp/0.1
GEMINI_API_KEY=your_gemini_api_key
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=quiz_app
OPENROUTER_API_KEY=your_openrouter_api_key
DEFAULT_DIFFICULTY=medium
DEFAULT_QUESTION_COUNT=10

# Origins allowed by the backend's CORS policy (comma-separated). Docker Compose
# reads this from the root .env; defaults to the frontend container origin.
CORS_ORIGINS=http://localhost:3000
# Browser-reachable backend origin, baked into the frontend bundle at build time.
VITE_API_BASE_URL=http://localhost:8000